# OpenAI API (required for cloud LLM)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily (required for market research, free tier: 1000 credits/month)
# Get your key at https://tavily.com
TAVILY_API_KEY=

# LLM Model Override (optional)
# Default: gpt-4o-mini
# Examples: "gpt-4o", "gpt-4o-mini", "ollama/qwen3:8b"
MINDSIM_MODEL=auto

# Research budget (max Tavily credits per simulation run)
MINDSIM_RESEARCH_BUDGET=10
